# Payload / Postgres
DATABASE_URI=postgres://postgres:postgres@localhost:5433/sansay
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (used for sitemap/robots/OG absolute URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob (media storage)
BLOB_READ_WRITE_TOKEN=

# Email tier precedence: RESEND_API_KEY → SMTP_HOST → Ethereal (local dev only).
# Leave both RESEND_API_KEY and SMTP_HOST empty locally to use Ethereal.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

# SMTP (tier 2) — used when RESEND_API_KEY is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Required in every non-production environment — all outbound mail is rewritten here
PREVIEW_MAIL_RECIPIENT=

# Secret for the daily purge cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Telegram (optional second channel, FR-014) — leave both unset to disable.
# Vercel applies changes to these on the next deploy (see research.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
